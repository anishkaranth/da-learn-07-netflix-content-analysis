-- da-learn-07 Netflix catalogue - DAX measures (home table: fact_titles)
Titles = COUNTROWS ( fact_titles )
Movies = CALCULATE ( [Titles], fact_titles[content_type] = "Movie" )
TV Shows = CALCULATE ( [Titles], fact_titles[content_type] = "TV Show" )
Movie Share % = DIVIDE ( [Movies], [Titles] )
TV Share % = DIVIDE ( [TV Shows], [Titles] )
Adult Rated % = DIVIDE ( CALCULATE ( [Titles], fact_titles[rating] IN { "TV-MA", "R", "NC-17" } ), [Titles] )
Kids Family % = DIVIDE ( CALCULATE ( [Titles], dim_rating[audience] IN { "1 Kids", "2 Older kids / family" } ), [Titles] )
Avg Movie Minutes = AVERAGE ( fact_titles[movie_minutes] )
Median Movie Minutes = MEDIAN ( fact_titles[movie_minutes] )
Avg Seasons = AVERAGE ( fact_titles[tv_seasons] )
Single Season Shows % = DIVIDE ( CALCULATE ( [TV Shows], fact_titles[tv_seasons] = 1 ), [TV Shows] )
Added Same Year % = DIVIDE ( CALCULATE ( [Titles], fact_titles[years_release_to_add] <= 0 ), CALCULATE ( [Titles], NOT ISBLANK ( fact_titles[years_release_to_add] ) ) )
Median Years To Add = MEDIAN ( fact_titles[years_release_to_add] )
Countries = DISTINCTCOUNT ( bridge_title_country[country_key] )
-- country-tagged titles: a co-production counts once per country (use with dim_country on the axis)
Country Titles = CALCULATE ( DISTINCTCOUNT ( bridge_title_country[show_id] ) )
Primary Country Titles = CALCULATE ( [Titles], bridge_title_country[is_primary] = 1 )
Genre Titles = CALCULATE ( DISTINCTCOUNT ( bridge_title_genre[show_id] ) )
Titles Added YoY % =
VAR cur = [Titles]
VAR prev = CALCULATE ( [Titles], FILTER ( ALL ( dim_date ), dim_date[year] = MAX ( dim_date[year] ) - 1 ) )
RETURN DIVIDE ( cur - prev, prev )
Cumulative Titles =
CALCULATE ( [Titles], FILTER ( ALL ( dim_date ), dim_date[date_key] > 0 && dim_date[date_key] <= MAX ( dim_date[date_key] ) ) )
